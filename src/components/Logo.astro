---
import LogoSvg from "../assets/icons/LogoSvg.svg";
---

<div
   class="h-10 absolute top-3 bg-white dark:bg-black px-6 rounded-br-[1.25rem] flex items-center"
>
   <a
      href="/"
      class="relative inline-flex text-lg items-center justify-center group overflow-hidden"
   >
      <LogoSvg width={18} height={18} />
      <div
         class="h-[28px] flex flex-col group-hover:-translate-y-[28px] transition-transform duration-300 ease-[cubic-bezier(0.95,0.05,0.795,0.035)]"
      >
         <span>Messmer Photography</span>
         <span>Messmer Photography</span>
      </div>
   </a>

   <!-- half rounded icon top-->
   <svg
      class="absolute top-0 -right-4 text-white dark:text-black"
      width="16"
      height="16"
      viewBox="0 0 16 16"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
   >
      <path
         d="M16 0L0 0L0 16C0 7.16333 7.16345 0 16 0Z"
         fill="currentColor"
         fill-rule="evenodd"></path>
   </svg>

   <!-- half rounded icon bottom-->
   <svg
      class="absolute -bottom-4 left-0 text-white dark:text-black"
      width="16"
      height="16"
      viewBox="0 0 16 16"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
   >
      <path
         d="M16 0L0 0L0 16C0 7.16333 7.16345 0 16 0Z"
         fill="currentColor"
         fill-rule="evenodd"></path>
   </svg>
</div>
