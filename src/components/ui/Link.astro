---
const { path, name, styles } = Astro.props;

import { cn } from "../../utils/cn";
---

<a href={path} class={cn("group overflow-hidden ", styles)}>
   <div
      class="flex flex-col group-hover:-translate-y-[24px] transition-transform duration-300 ease-[cubic-bezier(0.95,0.05,0.795,0.035)]"
   >
      <span>{name}</span>
      <span>{name}</span>
   </div>
</a>
