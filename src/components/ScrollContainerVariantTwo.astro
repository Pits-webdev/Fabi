---
import ImageComponente from "../components/ImageComponente.astro";
import Footer from "./Footer.astro";
import ScrollHero from "./ScrollHero.astro";
---

<div class="w-full h-full flex flex-col gap-3">
   <ScrollHero />

   <div class="flex gap-3 items-center justify-between">
      <ImageComponente
         imagePath="/src/assets/Model1.png"
         altText="A headshot of Priya against a brick wall background."
         styles="h-[calc(100vh-50%)]"
         pos="object-top"
      />

      <ImageComponente
         imagePath="/src/assets/Model2.png"
         altText="A headshot of Priya against a brick wall background."
         styles="h-[calc(100vh-50%)]"
         pos="object-top"
      />
   </div>

   <div class="flex gap-3 items-center justify-between">
      <ImageComponente
         imagePath="/src/assets/Model3.png"
         altText="A headshot of Priya against a brick wall background."
         styles="h-[calc(100vh-50%)]"
         pos="object-top"
      />

      <ImageComponente
         imagePath="/src/assets/Model4.png"
         altText="A headshot of Priya against a brick wall background."
         styles="h-[calc(100vh-50%)]"
         pos="object-top"
      />
   </div>

   <div class="flex gap-3 items-center justify-between">
      <ImageComponente
         imagePath="/src/assets/Model5.png"
         altText="A headshot of Priya against a brick wall background."
         styles="h-[calc(100vh-50%)]"
         pos="object-top"
      />

      <ImageComponente
         imagePath="/src/assets/Model6.png"
         altText="A headshot of Priya against a brick wall background."
         styles="h-[calc(100vh-50%)]"
         pos="object-top"
      />
   </div>

   <Footer />
</div>
