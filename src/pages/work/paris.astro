---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Logo from "../../components/Logo.astro";
import ImageComponente from "../../components/ImageComponente.astro";
import Footer from "../../components/Footer.astro";
---

<Layout title="Photography | Paris-Shooting">
   <div class="w-full h-full flex gap-3 px-3">
      <!-- sticky -->
      <div class="w-full h-screen py-3 sticky top-0 flex-1/2">
         <div
            class="h-full grid grid-rows-[calc(100vh-64px-(3*12px))_64px] gap-3"
         >
            <!--sticky Hero Image -->
            <div class="w-full h-full">
               <Logo />
               <ImageComponente
                  imagePath="/src/assets/Paris_Fashion_Week.jpg"
                  altText="A headshot of Priya against a brick wall background."
                  styles="object-top"
                  load="eager"
               />
            </div>

            <!-- navBar -->
            <Navbar />
         </div>
      </div>

      <!-- Scroll -->
      <div class="w-full h-full flex-1/2 py-3 flex flex-col gap-3">
         <!-- Scroll Content Top -->
         <div class="w-full h-fit full flex gap-3">
            <div
               class="flex-2/3 bg-white-light dark:bg-black-light p-10 flex flex-col justify-between rounded-2xl"
            >
               <h2 class="text-2xl">Pariser fashion week</h2>
               <p>
                  Lorem ipsum dolor sit amet consectetur adipisicing elit. Error
                  pariatur natus eos veniam sint, nihil ullam voluptatibus,
                  provident voluptate in dolorum aperiam omnis perspiciatis
                  laudantium.
               </p>
            </div>

            <div class="flex-1/3 flex flex-col gap-3">
               <div
                  class="bg-white-light dark:bg-black-light p-6 flex items-center justify-between rounded-lg"
               >
                  <p>Year</p>
                  <p>2024</p>
               </div>
               <div
                  class="bg-white-light dark:bg-black-light p-6 flex items-center justify-between rounded-xl"
               >
                  <p>Location</p>
                  <p>Paris</p>
               </div>
               <div
                  class="bg-white-light dark:bg-black-light p-6 flex items-center justify-between rounded-xl"
               >
                  <p>Service</p>
                  <p>Photo</p>
               </div>
               <div
                  class="bg-white-light dark:bg-black-light p-6 flex items-center justify-between rounded-xl"
               >
                  <p>Photograph</p>
                  <p>Fabian</p>
               </div>
            </div>
         </div>

         <!--scroll image Gallery -->
         <div class="grid grid-cols-1 gap-3">
            <div class="w-full h-fit">
               <ImageComponente
                  imagePath="/src/assets/Paris_model_1.jpg"
                  altText="A headshot of Priya against a brick wall background."
                  styles="h-[calc(100vh-(2*12px))] object-top"
                  load="eager"
               />
            </div>
            <div class="w-full h-fit">
               <ImageComponente
                  imagePath="/src/assets/Paris_model_2.jpg"
                  altText="A headshot of Priya against a brick wall background."
                  styles="h-[calc(100vh-(2*12px))] object-top"
                  load="eager"
               />
            </div>
            <div class="w-full h-fit">
               <ImageComponente
                  imagePath="/src/assets/Paris_model_3.jpg"
                  altText="A headshot of Priya against a brick wall background."
                  styles="h-[calc(100vh-(2*12px))] object-top"
                  load="eager"
               />
            </div>
         </div>

         <!-- Footer -->
         <Footer />
      </div>
   </div>
</Layout>
