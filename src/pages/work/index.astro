         <Footer />
      </div>
   </div>
</Layout>

<script>
   const titleImage = document.querySelector(".title_image [data-image]");
   const images = document.querySelectorAll(".gallery [data-image]");

   images.forEach((image) => {
      image.addEventListener("mouseover", function () {
         const hoverPath = image.getAttribute("src");

         if (titleImage?.getAttribute("src") === hoverPath) return;

         if (hoverPath) {
            titleImage?.setAttribute("src", hoverPath);
         }
      });
   });
</script>
