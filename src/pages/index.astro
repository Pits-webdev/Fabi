---
import Layout from "../layouts/Layout.astro";
import StudyHut from "../assets/icons/studyhut.svg";
import Navbar from "../components/Navbar.astro";
import Logo from "../components/Logo.astro";
import ImageComponente from "../components/ImageComponente.astro";
import Email from "../assets/icons/email.svg";
import Footer from "../components/Footer.astro";
---

<Layout title="Messmer Photography">
	<div class="w-full h-full flex gap-3 px-3">
		<!-- sticky -->
		<div class="w-full h-screen py-3 sticky top-0 flex-1/2">
			<div
				class="h-full grid grid-rows-[calc(70vh-64px-(4*12px))_64px_auto] gap-3"
			>
				<!--sticky Hero Image -->
				<div class="w-full h-full">
					<Logo />
					<ImageComponente
						imagePath="/src/assets/f_m.png"
						altText="A headshot of Priya against a brick wall background."
						styles="object-center"
						load="eager"
					/>
				</div>

				<!-- navBar -->
				<Navbar />

				<!-- sticky content -->
				<div
					class="bg-white-light dark:bg-black-light flex flex-col justify-end p-10 rounded-2xl"
				>
					<h2 class="text-2xl">Hallo ich bin Fabian</h2>
					<p class="mt-3 mb-6">
						Lorem ipsum dolor sit amet consectetur adipisicing elit.
						Dicta, quasi neque natus odio ut velit dolores provident!
						Asperiores, dignissimos, modi doloribus pariatur cum deserunt
						assumenda vitae ut architecto libero quae?
					</p>

					<p class="flex items-center gap-2">
						<Email width={16} height={16} /> fabian.messmer@email.com
					</p>
				</div>
			</div>
		</div>

		<!-- Scroll -->
		<div class="w-full h-full flex-1/2 py-3 flex flex-col gap-3">
			<!-- Scroll Content Top -->
			<div class="w-full h-fit full flex gap-3">
				<div
					class="flex-2/3 bg-white-light dark:bg-black-light p-10 flex flex-col justify-between rounded-2xl"
				>
					<h2 class="text-2xl">Services</h2>
					<p>
						Lorem ipsum dolor sit amet consectetur adipisicing elit. Error
						pariatur natus eos veniam sint, nihil ullam voluptatibus,
						provident voluptate in dolorum aperiam omnis perspiciatis
						laudantium.
					</p>
				</div>

				<div class="flex-1/3 flex flex-col gap-3">
					<div
						class="bg-white-light dark:bg-black-light p-6 flex items-center justify-between rounded-lg"
					>
						<p>Ausbildung</p>

						<StudyHut width={38} height={16} />
					</div>
					<div
						class="bg-white-light dark:bg-black-light p-6 flex items-center justify-between rounded-xl"
					>
						<p>Photograph</p>
						<p>2023</p>
					</div>
					<div
						class="bg-white-light dark:bg-black-light p-6 flex items-center justify-between rounded-xl"
					>
						<p>Video und Ton</p>
						<p>2025</p>
					</div>
					<div
						class="bg-white-light dark:bg-black-light p-6 flex items-center justify-between rounded-xl"
					>
						<p>Nebengewerbe</p>
						<p>2025</p>
					</div>
				</div>
			</div>

			<!--scroll image Gallery -->
			<div class="grid grid-cols-2 gap-3">
				<ImageComponente
					imagePath="/src/assets/Paris_Fashion_Week.jpg"
					altText="A headshot of Priya against a brick wall background."
					styles="object-top"
					load="eager"
				/>

				<ImageComponente
					imagePath="/src/assets/Paris_model_1.jpg"
					altText="A headshot of Priya against a brick wall background."
					styles="object-top"
					load="eager"
				/>

				<ImageComponente
					imagePath="/src/assets/Paris_model_2.jpg"
					altText="A headshot of Priya against a brick wall background."
					styles="object-top"
					load="lazy"
				/>

				<ImageComponente
					imagePath="/src/assets/Paris_model_3.jpg"
					altText="A headshot of Priya against a brick wall background."
					styles="object-top"
					load="lazy"
				/>

				<ImageComponente
					imagePath="/src/assets/Hochzeit_1.jpg"
					altText="A headshot of Priya against a brick wall background."
					styles="object-top"
					load="lazy"
				/>

				<ImageComponente
					imagePath="/src/assets/Hochzeit_2.jpg"
					altText="A headshot of Priya against a brick wall background."
					styles="object-top"
					load="lazy"
				/>
			</div>

			<!-- Footer -->
			<Footer />
		</div>
	</div>
</Layout>
