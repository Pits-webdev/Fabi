---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Logo from "../../components/Logo.astro";
import ImageComponente from "../../components/ImageComponente.astro";
import Email from "../../assets/icons/email.svg";
import Footer from "../../components/Footer.astro";
---

<Layout title="Messmer Photography | Blog">
   <div class="w-full h-full flex gap-3 px-3">
      <!-- sticky -->
      <div class="w-full h-screen py-3 sticky top-0 flex-1/2">
         <div
            class="h-full grid grid-rows-[calc(100vh-64px-(3*12px))_64px] gap-3"
         >
            <!--sticky Hero Image -->
            <div class="w-full h-full">
               <Logo />
               <ImageComponente
                  imagePath="/src/assets/Model1.png"
                  altText="A headshot of Priya against a brick wall background."
                  styles="object-top"
                  load="eager"
               />
            </div>

            <!-- navBar -->
            <Navbar />
         </div>
      </div>

      <!-- Scroll -->
      <div class="w-full h-full flex-1/2 py-3 flex flex-col gap-3">
         <!-- Scroll Content Top -->
         <div class="w-full h-fit full flex gap-3">
            <div
               class="flex-2/3 bg-white-light dark:bg-black-light p-10 flex flex-col justify-between rounded-2xl"
            >
               <h2 class="text-2xl">Blog</h2>
